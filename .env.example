# =============================================================================
# Environment variables for local development.
#
# Copy this file to .env and fill in the values you actually need:
#
#     cp .env.example .env
#
# .env is gitignored — never commit real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# Exactly ONE provider is active per process. Everything below in the
# "Provider credentials" section is optional EXCEPT the credential belonging to
# the provider you select here.
#
# Valid values: bedrock | anthropic | openai | google
# Default (when unset): openai -- one API key, no cloud account needed.
# bedrock needs an AWS account, which not everyone has.
LLM_PROVIDER="openai"

# Optional. Overrides the provider's default model. Model ID formats are
# provider specific and NOT interchangeable — if you switch LLM_PROVIDER,
# either update this too or comment it out to fall back to the default.
#
# The defaults below are a snapshot and WILL go stale: vendors release, rename,
# and retire models on their own schedules. If you hit an "unknown model" error,
# check the provider's current model list first. Setting LLM_MODEL_ID here is the
# right way to move to a newer model without editing code.
#
#   bedrock   -> us.amazon.nova-lite-v1:0
#   anthropic -> claude-haiku-4-5-20251001
#   openai    -> gpt-5.6-luna
#   google    -> gemini-3.5-flash-lite
#
#LLM_MODEL_ID="gpt-5.6-luna"


# -----------------------------------------------------------------------------
# Provider credentials — fill in ONLY the one matching LLM_PROVIDER
#
# No per-provider install step: `mise run inst` runs `uv sync --all-extras`, and
# requirements.txt (what Vercel installs) is exported with --all-extras too, so
# every provider's SDK is present in both places. Switching provider is one
# environment variable, never a reinstall or a redeploy config change.
# -----------------------------------------------------------------------------

# --- LLM_PROVIDER="bedrock" ---
# Bedrock authenticates with AWS credentials, not an API key.
#
# LOCAL DEVELOPMENT: leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY COMMENTED
# OUT. boto3 reads environment variables BEFORE ~/.aws/credentials, so setting
# them here — even to a placeholder like "..." — shadows your working local
# profile and Bedrock fails with a confusing "UnrecognizedClientException:
# The security token included in the request is invalid".
#
# DEPLOYMENT (Vercel): serverless has no ~/.aws, so set both as real
# environment variables in the Vercel dashboard instead of in this file.
AWS_REGION="us-east-1"
#AWS_ACCESS_KEY_ID="..."
#AWS_SECRET_ACCESS_KEY="..."

# --- LLM_PROVIDER="anthropic" --- Claude API key, from console.anthropic.com
#ANTHROPIC_API_KEY="sk-ant-..."

# --- LLM_PROVIDER="openai" --- OpenAI API key, from platform.openai.com  [DEFAULT]
#OPENAI_API_KEY="sk-..."

# --- LLM_PROVIDER="google" --- Gemini API key, from aistudio.google.com
#GOOGLE_API_KEY="..."


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# REQUIRED, including for local development. The agent reads the same NeonDB
# Postgres instance everywhere; it no longer falls back to SQLite on a laptop.
#
# That used to be the arrangement, and it produced a specific bug: every SQL
# example in the system prompt was written and tested against SQLite, then
# shipped to a Postgres deployment where strftime, JULIANDAY and
# `DATE(x, '-30 days')` do not exist. Nothing crashed, because the agent's SQL
# tool hands database errors back to the model as text, so the only symptom was
# worse answers in production. One database everywhere is what keeps a single
# prompt honest.
#
# SQLite is still the seed the dataset ships (data/data.sqlite.example) and the
# source the sync reads. First-time setup:
#
#     mise run setup-db     # seed tmp/data.sqlite from the committed copy
#     mise run sync-db      # publish it into this project's Postgres schema
#
# Use the -pooler host. Tables live in the schema named by `database.schemaName`
# in data/dataset.toml, so other projects can share this instance untouched.
#DB_HOST="...-pooler.c-4.us-east-1.aws.neon.tech"
#DB_PORT="5432"
#DB_USER="neondb_owner"
#DB_PASS="npg_1a2b3c..."
#DB_NAME="neondb"

# --- Monthly LLM spend cap (optional, OFF by default) -------------------------
# Only for a public deployment where the person paying is not the person typing.
# Leave it off for local development: you are spending your own allowance and a
# cap would just get in the way. Turning it on needs a DynamoDB table whose
# partition key is `app_id` (type String); nothing else about the table matters.
# The row key is `<project.name from config/dataset.toml>-YYYY-MM`, so one table
# can hold the counters for several projects.
#QUOTA_ENABLED="false" # true| false
#DYNAMODB_TABLE_NAME_QUOTA="my-llm-quota"
#QUOTA_MAX_INVOKE_PER_MONTH="1000"
#QUOTA_MAX_INPUT_TOKEN_PER_MONTH="50000000"
#QUOTA_MAX_OUTPUT_TOKEN_PER_MONTH="10000000"
